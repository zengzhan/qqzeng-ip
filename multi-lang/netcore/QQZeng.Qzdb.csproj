<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架：多框架支持 net8.0 (LTS), net9.0, net10.0, net11.0 -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <OutputType>Library</OutputType>

    <!-- 语言/编译选项 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
        Nullable / ImplicitUsings / LangVersion / InvariantGlobalization 原本由
        ../Directory.Build.props 统一提供，但该文件不在 GitHub 发布仓库的同步清单内
        （ip-qzdb-sdk/netcore/ 只发布 *.cs + csproj + README.md），导致发布仓库里的
        C# SDK 脱离上层 props 后独立编译直接失败——缺 Nullable 触发 CS8632（121 处）、
        缺 ImplicitUsings 导致 Span<> / Memory<> / ReadOnlySpan<> 找不到（CS0246）。
        现改为在 csproj 内显式声明，使 SDK 自包含；取值与 Directory.Build.props 保持一致，
        开发仓库侧行为不变（csproj 与 props 同值时以 csproj 为准，无冲突）。
    -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 静态分析：显式开启最严格档位（此前仅 release notes 声称 AnalysisMode=All，实际为默认 8.0 档）。
         AnalysisMode=All + TreatWarningsAsErrors 保证每个 CA 规则告警都必须被显式处理（修复或带理由抑制），
         防止分析器档位在无人注意时悄悄回退。配套的逐规则开关/抑制见 netcore/.editorconfig。
         注意：刻意【不】开启 EnforceCodeStyleInBuild —— 它会在被不同目录 ProjectReference 消费时抛出
         大量预存的 IDE 风格规则（IDE0008/IDE0055/IDE0058/IDE0046…，均为库既有 K&R 风格），
         且行为依赖构建目录、不可移植。风格规则按 .editorconfig 保持 suggestion（仅 IDE 提示）、
         真正把关的是上述 CA 规则。 -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 包、程序集与规范命名空间统一：QQZeng.Qzdb -->
    <PackageId>QQZeng.Qzdb</PackageId>
    <RootNamespace>QQZeng.Qzdb</RootNamespace>
    <AssemblyName>QQZeng.Qzdb</AssemblyName>
    <Version>1.0.7</Version>

    <!--
        SDK 内建包验证（无需额外 NuGet 包）：EnablePackageValidation + PackageValidationBaselineVersion
        使 dotnet pack 在打包后自动运行 Microsoft.DotNet.ApiCompat 校验，把当前程序集公开 API 与
        上一已发布基线包 1.0.6 对比——任何删除/改名/改签名的破坏性变更都会让 pack 失败。
        基线包从 NuGet 还原（qqzeng.qzdb/1.0.6 已发布于 nuget.org）。
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.6</PackageValidationBaselineVersion>
    <PackageReleaseNotes>1.0.7: Add .NET 11 (net11.0) target framework support and full public API documentation:
- net11.0: Added as a fourth target framework (net8.0;net9.0;net10.0;net11.0); System.IO.Hashing referenced explicitly (net11 targeting pack does not expose Crc32 built-in).
- Analytics: Enabled strictest AnalysisMode=All + TreatWarningsAsErrors with documented .editorconfig suppressions; real code fixes for CA1032 (QzdbException ctors), CA1062 (GeoInfo null guard), CA1859 (ChainedReader ReadOnlyCollection); EnforceCodeStyleInBuild intentionally not enabled (non-portable under ProjectReference).
- Package validation: baseline moved to 1.0.6; ApiCompat confirmed no breaking API change.
- Documentation: Full XML docs for all public API members (CS1591 clean, 13KB→56KB XML).</PackageReleaseNotes>

    <!-- 作者 / 公司 / 描述 -->
    <Authors>QQZeng</Authors>
    <Company>QQZeng</Company>
    <Product>QZDB .NET SDK</Product>
    <Description>Official .NET SDK for the QQZeng QZDB IP geolocation database. Offline, dependency-free, high-performance IPv4/IPv6 lookup with a lock-free, hot-reloadable reader/registry API. 纯离线 IP 地理定位数据库官方 .NET SDK，零依赖、支持热更新。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ip;geolocation;qqzeng;qzdb;ipv4;ipv6;offline;ipdatabase;network;lookup</PackageTags>
    <PackageProjectUrl>https://github.com/zengzhan/qqzeng-ip/tree/main/qzdb/netcore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zengzhan/qqzeng-ip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 文档 + 符号包 + 确定性构建 + SourceLink 调试支持 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!--
        net8.0/net9.0 对 SDK 10 包验证工具已属"不再受支持"的框架，跨 TFM 与基线比对会产生 PKV006 噪音。
        忽略这两个基线框架，仅对 net10.0 与基线 1.0.5 做真实 API 兼容校验。
    -->
    <PackageValidationBaselineFrameworkToIgnore Include="net8.0" />
    <PackageValidationBaselineFrameworkToIgnore Include="net9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <!-- net9.0/net10.0/net11.0: System.IO.Hashing is expected to be built into the shared
       framework, but the targeting packs for these TFMs do not expose it,
       so the package is referenced explicitly to keep all 4 TFMs compiling. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

</Project>
