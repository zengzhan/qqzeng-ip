<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架：多框架支持 net8.0 (LTS), net9.0, net10.0 -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>

    <!-- 语言/编译选项 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 包、程序集与规范命名空间统一：QQZeng.Qzdb -->
    <PackageId>QQZeng.Qzdb</PackageId>
    <RootNamespace>QQZeng.Qzdb</RootNamespace>
    <AssemblyName>QQZeng.Qzdb</AssemblyName>
    <Version>1.0.4</Version>
    <PackageReleaseNotes>1.0.4: Align native float formatting with the canonical cross-language contract — whole-number floats render as integer form (e.g. 116) and non-whole as 6 decimals (F6); NaN/Infinity render as empty string. Verified byte-exact against all 8 language SDKs over 4102 golden vectors.</PackageReleaseNotes>

    <!-- 作者 / 公司 / 描述 -->
    <Authors>QQZeng</Authors>
    <Company>QQZeng</Company>
    <Product>QZDB .NET SDK</Product>
    <Description>Official .NET SDK for the QQZeng QZDB IP geolocation database. Offline, dependency-free, high-performance IPv4/IPv6 lookup with a lock-free, hot-reloadable reader/registry API. 纯离线 IP 地理定位数据库官方 .NET SDK，零依赖、支持热更新。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ip;geolocation;qqzeng;qzdb;ipv4;ipv6;offline;ipdatabase;network;lookup</PackageTags>
    <PackageProjectUrl>https://github.com/zengzhan/qqzeng-ip/tree/main/qzdb/netcore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zengzhan/qqzeng-ip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 文档 + 符号包 + 确定性构建 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
