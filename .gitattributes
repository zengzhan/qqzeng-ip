# Composer / Packagist dist 裁剪（发布仓库 qqzeng-ip 根目录）
#
# ⚠️ 本文件的路径是 **GitHub 发布仓库** 的语境（SDK 在 `ip-qzdb-sdk/`），
#    不是开发仓库的 `multi-lang/`。它由 `tools/sync_to_github.py` 的
#    `sync_publish_meta()` 从 `tools/publish_meta/` 拷到本仓库根目录后生效。
#    在本仓库里直接改会被下次同步覆盖 —— 改源头，改完跑一次同步脚本。
#
# Packagist 不直接读 git，而是下载 GitHub 生成的源码归档（zipball）；GitHub 生成归档时
# 会应用 export-ignore 属性。本仓库聚合了 4 条产品线（IP 数据库 QZDB / 经典版 / 历史版 /
# 手机号段）与 SQL DDL，若不裁剪，PHP 用户 `composer require qqzeng/qzdb` 会下载约 2.5 MB
# 与它毫不相干的内容。裁剪后 dist 约 150 KB。
#
# 两条必须记住的 gitattributes 语义（踩过的坑，改动后务必重跑下面的验证命令）：
#
# 1. gitattributes **不支持** `!` 反选——git 2.40+ 会直接忽略该行并打印
#    "Negative patterns are ignored in git attributes"。要覆盖前面的通配忽略，
#    必须显式写 `-export-ignore`（unset），且放在被覆盖的规则**之后**。
# 2. **目录**一旦被 `export-ignore`，`git archive` 就不再递归进入它——即使后面用
#    `-export-ignore` 放行目录内的文件也不会生效。所以绝不能写
#    `/ip-qzdb-sdk/** export-ignore`，必须逐项列出要忽略的目录。
#
# export-ignore 只作用于 `git archive` 与 GitHub 归档，不影响 git clone、本地开发与 CI
# 检出——工作区内容完全不变。
#
# 验证方式（在发布仓库副本里跑）：
#   git add -A && TREE=$(git write-tree) && git archive "$TREE" | tar -t | sort
# 期望只看到：.gitignore、LICENSE、composer.json、
#            ip-qzdb-sdk/php/QzdbReader.php、ip-qzdb-sdk/php/README.md（外加空目录壳）

# --- 顶层：非 QZDB 产品线与仓库文档 ---
/.github/**               export-ignore
/database-sql/**          export-ignore
/ip-classic-sdk/**        export-ignore
/ip-history-sdk/**        export-ignore
/phone-location-sdk/**    export-ignore
/demo/**                  export-ignore
/docs/**                  export-ignore
/CHANGELOG.md             export-ignore
/PUBLISHING.md            export-ignore
/README.md                export-ignore
/.gitattributes           export-ignore

# --- ip-qzdb-sdk：逐项忽略非 PHP 语言目录 ---
# （不能写成 /ip-qzdb-sdk/** —— 见上方第 2 条，目录被忽略后不再递归）
/ip-qzdb-sdk/c/**              export-ignore
/ip-qzdb-sdk/go/**             export-ignore
/ip-qzdb-sdk/java/**           export-ignore
/ip-qzdb-sdk/netcore/**        export-ignore
/ip-qzdb-sdk/nodejs/**         export-ignore
/ip-qzdb-sdk/python/**         export-ignore
/ip-qzdb-sdk/rust/**           export-ignore
/ip-qzdb-sdk/*.md              export-ignore
/ip-qzdb-sdk/*.sh              export-ignore
/ip-qzdb-sdk/.gitignore        export-ignore

# --- ip-qzdb-sdk/php：忽略测试脚本，只放行 SDK 入口 ---
# （顺序不可调换：`-export-ignore` 必须位于通配规则之后才能覆盖它）
/ip-qzdb-sdk/php/*                export-ignore
/ip-qzdb-sdk/php/QzdbReader.php   -export-ignore
/ip-qzdb-sdk/php/README.md        -export-ignore
