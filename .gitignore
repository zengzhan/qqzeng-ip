# Purchased IP database files (must be obtained separately)
*.csv
*.qzdb
*.db

# Build artifacts
bin/
# Exception: Rust convention puts BINARY SOURCE files in src/bin/, not build output.
# Without this negation the `bin/` rule above silently drops the 4 [[bin]] source
# targets declared in rust/Cargo.toml, and `cargo build` fails on a fresh clone.
!multi-lang/rust/src/bin/
obj/
*.csproj.user
*.suo

# OS
.DS_Store
Thumbs.db

# Large raw text data (IP ranges, failure logs)
ipv4*.txt
failures_*.txt

# Test result dumps (large IP range outputs)
multi-lang/tools/results/
tools/results/
multi-lang/.test_results/
.test_results/

# Test case fixtures (large generated IP range dumps)
multi-lang/tools/test_cases/
tools/test_cases/

# Compiled test binaries
multi-lang/tools/batch_go
multi-lang/tools/batch_c
multi-lang/tools/batch_rust
multi-lang/tools/bench_c
multi-lang/test_runner_bin/
multi-lang/tools/batch_csharp_out/
multi-lang/c/qzdb_demo
multi-lang/c/bench_qps
*.exe


# Agent / session state
.agent/
.omc/
.omo/
.omx/
.workbuddy/

# Paid data derived dumps (never commit query results of purchased DBs)
multi-lang/data/verify_*.txt
multi-lang/data/test.txt

# Backups
*.bak
*.orig

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo

# Compiled test binaries
multi-lang/c/bench_qps
multi-lang/c/qzdb_test
multi-lang/c/golden_check
multi-lang/c/test_main
multi-lang/c/*.o
multi-lang/rust/bench_qps
multi-lang/rust/target/
multi-lang/go/bench_qps
*.o
*.obj

# Debug symbol bundles (macOS build artifacts)
*.dSYM/
multi-lang/c/*.dSYM/

# PHP Tier1 synthetic test fixtures (generated, not source)
multi-lang/php/.tier1_synthetic.qzdb*

# Language specific
node_modules/
vendor/
# PHP 包的 lock 文件不入库（composer.json 是库定义，锁文件属于消费方应用）；
# 注意 vendor/ 已忽略，但 composer.lock 需要单独排除，否则本地验证时会误提交。
/composer.lock
target/
build/
*.class
*.pyc
__pycache__/
*.egg-info/
# Python 构建产物（sdist / wheel / build）
dist/
build/python/

# Analysis / optimization docs (not part of SDK)
optimization_analysis.md
todo.md
优化.md
优化方案参考.html

# SECRETS: Maven Central publish credentials (Sonatype token, GPG, SSH) - NEVER COMMIT
docs/QZDB_MAVEN_CENTRAL_PUBLISH.md
docs/QZDB_PUBLISH_CREDENTIALS.md
gpg_private_armored.asc
settings.xml
ci_settings.xml

# Compiled Go binary
multi-lang/go/main

# Temp
tmp/
*.tmp
# Playwright MCP browser automation artifacts (page snapshots, screenshots)
.playwright-mcp/

# NuGet pack/publish artifacts (fully rebuildable from csproj)
multi-lang/netcore/nupkgs/

# Test run reports (regenerated each run, timestamped filenames)
multi-lang/java/test_reports/

# Exception: the published demo sample (public upstream zengzeng/qqzeng-ip)
# is intentionally tracked so CI can run data-backed verification without
# secrets or downloads. Real/purchased databases remain ignored above.
!demo/*.qzdb
!demo/*.csv
