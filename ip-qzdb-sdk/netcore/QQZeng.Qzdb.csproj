<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架：多框架支持 net8.0 (LTS), net9.0, net10.0 -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>

    <!-- 语言/编译选项 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 包、程序集与规范命名空间统一：QQZeng.Qzdb -->
    <PackageId>QQZeng.Qzdb</PackageId>
    <RootNamespace>QQZeng.Qzdb</RootNamespace>
    <AssemblyName>QQZeng.Qzdb</AssemblyName>
    <Version>1.0.5</Version>
    <PackageReleaseNotes>1.0.5: Major performance &amp; correctness upgrade — direct physical field projection in FindFields (80%+ allocation reduction); pre-bound standard field indices in GeoInfo (zero-allocation GetCountry/Isp/Asn/City/Province getters); epoch-based latest-wins reload protection; stackalloc IPAddress conversions; zero-delegate ChainedReader; pure integer IPv6 Find(ulong, ulong) achieving 7.6M+ QPS.</PackageReleaseNotes>

    <!-- 作者 / 公司 / 描述 -->
    <Authors>QQZeng</Authors>
    <Company>QQZeng</Company>
    <Product>QZDB .NET SDK</Product>
    <Description>Official .NET SDK for the QQZeng QZDB IP geolocation database. Offline, dependency-free, high-performance IPv4/IPv6 lookup with a lock-free, hot-reloadable reader/registry API. 纯离线 IP 地理定位数据库官方 .NET SDK，零依赖、支持热更新。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ip;geolocation;qqzeng;qzdb;ipv4;ipv6;offline;ipdatabase;network;lookup</PackageTags>
    <PackageProjectUrl>https://github.com/zengzhan/qqzeng-ip/tree/main/qzdb/netcore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zengzhan/qqzeng-ip</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 文档 + 符号包 + 确定性构建 + SourceLink 调试支持 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <!-- net9.0/net10.0: System.IO.Hashing is expected to be built into the shared
       framework, but this build environment's targeting packs do not expose it,
       so the package is referenced explicitly to keep all 3 TFMs compiling. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

</Project>
